{
  "kind": "collectionType",
  "collectionName": "blog_comments",
  "info": {
    "singularName": "blog-comment",
    "pluralName": "blog-comments",
    "displayName": "Blog Comment"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "content": {
      "type": "text",
      "required": true
    },
    "post": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::post.post",
      "inversedBy": "comments"
    },
    "author_user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "parent": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::blog-comment.blog-comment",
      "inversedBy": "replies"
    },
    "replies": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::blog-comment.blog-comment",
      "mappedBy": "parent"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "approved",
        "pending",
        "blocked"
      ],
      "default": "approved"
    },
    "isSpam": {
      "type": "boolean",
      "default": false
    }
  }
}
