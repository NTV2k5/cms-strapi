{
  "kind": "collectionType",
  "collectionName": "series",
  "info": {
    "singularName": "blog-series",
    "pluralName": "series",
    "displayName": "Series"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "description": {
      "type": "text"
    },
    "posts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::post.post",
      "mappedBy": "series"
    }
  }
}
